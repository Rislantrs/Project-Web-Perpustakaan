# --- CONFIGURATION FOR STANDALONE BOOKING ---

# Database mode: 'supabase' atau 'api' (jika menggunakan database WordPress/REST API)
VITE_BOOKING_DB_MODE=supabase

# Supabase Credentials (jika VITE_BOOKING_DB_MODE=supabase)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# REST API Credentials (jika VITE_BOOKING_DB_MODE=api)
# VITE_BOOKING_API_URL=https://web-utama-wordpress.com/wp-json/booking/v1
# VITE_BOOKING_API_TOKEN=rahasia_token_keamanan_wp_disipusda

# URL Web Utama WordPress Anda (untuk tombol "Kembali ke Web Utama")
VITE_MAIN_WEBSITE_URL=https://web-utama-wordpress.com

# Sakelar fitur
VITE_ENABLE_BOOKING=true
